    "react": "19.0.0",
    "react-dom": "19.0.0",
    "remotion": "4.0.535"
  },
  "devDependencies": {
    "@types/react": "19.0.6",
    "@types/react-dom": "19.0.3",
    "esbuild": "0.28.1",
    "prettier": "^3.5.3",
    "typescript": "5.7.3"
  }
}
